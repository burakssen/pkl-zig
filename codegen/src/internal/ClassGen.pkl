@Unlisted
module pkl.zig.internal.ClassGen

extends "Gen.pkl"

import "pkl:reflect"

import "ZigMapping.pkl"
import "Type.pkl"
import "typegen.pkl"
import "utils.pkl"

clazz: reflect.Class = mapping.source as reflect.Class

classInfo: ZigMapping.Class = mapping as ZigMapping.Class
local function resolvePropertyType(owner: reflect.Class, prop: reflect.Property): reflect.Type =
  if (prop.type is reflect.UnknownType && owner.superclass != null)
    let (superProp = owner.superclass!!.allProperties.getOrNull(prop.name))
      if (superProp != null) resolvePropertyType(owner.superclass!!, superProp!!) else prop.type
  else
    prop.type
local function genericDeclarationForType(type: reflect.Type): reflect.TypeDeclaration? =
  if (type is reflect.NullableType)
    genericDeclarationForType(type.member)
  else if (type is reflect.DeclaredType)
    let (referent = type.referent)
      if (
        referent is reflect.Class
          && (referent.modifiers.contains("abstract") || referent.modifiers.contains("open"))
          && !referent.enclosingDeclaration.uri.startsWith("pkl:")
      )
        referent
      else
        null
  else
    null
local function genericParamName(decl: reflect.TypeDeclaration): String = "\(utils.toZigName(decl))Type"
local function hasLegalOverride(owner: reflect.Class, prop: reflect.Property): Boolean =
  if (prop.type is reflect.UnknownType || owner.superclass == null)
    true
  else
    let (superProp = owner.superclass!!.allProperties.getOrNull(prop.name))
      if (superProp == null || superProp!!.type is reflect.UnknownType)
        true
      else
        let (propType = typegen.generateType(prop.type, owner, module.mappings).render(classInfo.packageName))
        let (superType = typegen.generateType(resolvePropertyType(owner.superclass!!, superProp!!), owner.superclass!!, module.mappings).render(classInfo.packageName))
          if (propType == superType)
            true
          else
            throw("Illegal override: property `\(prop.name)` in `\(owner.reflectee)` has Zig type `\(propType)`, but inherited property has Zig type `\(superType)`.")
local function hasLegalOverrides(): Boolean =
  clazz.properties.values.every((prop) -> hasLegalOverride(clazz, prop))

local sourceProperties =
  if (clazz.enclosingDeclaration.moduleClass == clazz)
    clazz.properties
  else
    clazz.allProperties
local genericTypes: Mapping<reflect.TypeDeclaration, String> = new Mapping {
  when (clazz.enclosingDeclaration.moduleClass == clazz) {
    for (_, prop in sourceProperties) {
      when (genericDeclarationForType(resolvePropertyType(clazz, prop)) != null) {
        [genericDeclarationForType(resolvePropertyType(clazz, prop))!!] =
          genericParamName(genericDeclarationForType(resolvePropertyType(clazz, prop))!!)
      }
    }
  }
}
local genericParams = genericTypes.fold(List(), (acc, _, value) -> acc.add(value))
local fields: Map<String, ZigStructField> =
  sourceProperties
    .filter((_, prop: reflect.Property) -> !prop.allModifiers.contains("hidden"))
    .mapValues((_, prop: reflect.Property) -> new ZigStructField {
      name = utils.toZigFieldName(prop)
      pklName = prop.name
      type = typegen.generateTypeWithGenerics(resolvePropertyType(clazz, prop), clazz, module.mappings, genericTypes)
      docComment = prop.docComment
    })
contents: String(hasLegalOverrides()) =
  new Listing {
    utils.renderHeaderComment(clazz.enclosingDeclaration)
    "const std = @import(\"std\");"
    "const pkl = @import(\"pkl\");"
    for (dep in module.mappings.filter((it) -> it.packageName == classInfo.packageName && it.name != classInfo.name)) {
      "const \(dep.name) = @import(\"\(dep.name).pkl.zig\").\(dep.name);"
    }
    ""
    when (clazz.docComment != null) {
      utils.renderDocComment(clazz.docComment!!, "")
    }
    if (genericParams.isEmpty)
      "pub const \(classInfo.name) = struct {"
    else
      "pub fn \(classInfo.name)(\(genericParams.map((it) -> "comptime \(it): type").join(", "))) type { return struct {"
    for (_, field in fields) {
      when (field.docComment != null) {
        utils.renderDocComment(field.docComment!!, "    ")
      }
      "    \(field.name): \(field.type.render(classInfo.packageName)),"
    }
    ""
    "    pub fn pklFieldName(comptime field_name: []const u8) []const u8 {"
    "        return inline for (field_names) |entry| {"
    "            if (std.mem.eql(u8, field_name, entry.zig)) break entry.pkl;"
    "        } else field_name;"
    "    }"
    ""
    "    pub fn deinit(self: *@This(), allocator: std.mem.Allocator) void {"
    "        pkl.deinit(@This(), allocator, self);"
    "    }"
    ""
    "    const field_names = [_]struct { zig: []const u8, pkl: []const u8 }{"
    for (_, field in fields) {
      "        .{ .zig = \(utils.toZigString(utils.identifierFieldName(field.name))), .pkl = \(utils.toZigString(field.pklName)) },"
    }
    "    };"
    when (clazz.enclosingDeclaration.moduleClass == clazz) {
      ""
      "    pub fn loadFromPath(allocator: std.mem.Allocator, io: std.Io, path: []const u8) !@This() {"
      "        var evaluator = try pkl.Evaluator.init(io, allocator, .{});"
      "        defer evaluator.deinit();"
      "        return evaluator.loadFromPath(@This(), path);"
      "    }"
      ""
      "    pub fn load(evaluator: *pkl.Evaluator, module_uri: []const u8) !@This() {"
      "        return evaluator.load(@This(), module_uri);"
      "    }"
    }
    if (genericParams.isEmpty)
      "};"
    else
      "}; }"
    ""
  }.join("\n")
class ZigStructField {
  name: String
  pklName: String
  type: Type
  docComment: String?
}
